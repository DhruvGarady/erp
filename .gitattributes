# Normalize all text to LF in the repository.
# Without this, committing from Windows and Linux produces whole-file
# diffs that conflict on every line -- see commit 3052e6b, which rewrote
# 116 files as pure CRLF churn.
* text=auto eol=lf

# Explicit text types
*.js    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.sql   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf

# Binary -- never touch these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.ico   binary
*.gif   binary
